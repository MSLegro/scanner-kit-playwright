# ===============================================================
# Configuración de ScannerKit Playwright (.env)
# ===============================================================

# URL de la web que se va a escanear.
# También puedes pasarla por consola: pnpm scan --url=https://mi-erp.empresa.com
# Deja esta variable vacía para usar el servidor local de prueba (ERP simulado).
TARGET_URL=

# Modo de ejecución del navegador:
# true = sin interfaz visual (ideal para servidores / CI/CD)
# false = con ventana visual interactiva
HEADLESS=false

# Modo Interactivo:
# true = Mantiene el navegador abierto indefinidamente para que navegues,
#        inicies sesión o hagas clic manualmente. Cuando termines tu flujo,
#        simplemente cierras la ventana con la [X] del ratón o presionas [ENTER] en la terminal.
# false = Cierra automáticamente tras cargar la página.
INTERACTIVE=true

# Pausa visual en milisegundos entre acciones programáticas (0 durante escaneo manual)
SLOW_MO=0

# En modo escaneo se mantienen en false para observar la página normal
# sin bloquear imágenes ni alterar prototipos nativos (evita detección de Cloudflare Turnstile).
# El escáner medirá pasivamente el potencial de ahorro y lo reportará en recon-report.json.
TURBO_MODE=false
EVASION_MODE=false

# Activar Auditoría y Radiografía Técnica Pasiva de red
RECON_MODE=true

# Rutas de destino y organización del blueprint
# Directorio base de salida (por defecto: ./blueprint en el directorio actual)
BLUEPRINT_DIR=./blueprint

# Categoría o subcarpeta opcional para clasificar los reportes dentro del target
# Ejemplo: TARGET_CATEGORY=autorizaciones
TARGET_CATEGORY=

