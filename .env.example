# ===============================================================
# Configuración de ScannerKit Playwright (.env)
# ===============================================================

# URL de la web que se va a escanear.
# Deja esta variable vacía para usar el servidor local de prueba (ERP simulado).
# Ejemplo: TARGET_URL=https://mi-erp.empresa.com
TARGET_URL=

# Modo de ejecución del navegador:
# true = sin interfaz visual (ideal para servidores / CI/CD)
# false = con ventana visual interactiva
HEADLESS=false

# Modo Interactivo:
# true = Mantiene el navegador abierto indefinidamente para que navegues,
#        inicies sesión o hagas clic manualmente. Cuando termines tu flujo,
#        presionas [ENTER] en la terminal o cierras la ventana para exportar los reportes.
# false = Cierra automáticamente tras cargar la página.
INTERACTIVE=true

# Pausa visual en milisegundos entre acciones de Playwright (solo aplica si HEADLESS=false)
SLOW_MO=300

# Activar Modo Turbo (bloqueo de imágenes, medios y trackers pesados)
TURBO_MODE=true

# Activar Evasión de UI (anula window.print, beforeunload y auto-resuelve diálogos)
EVASION_MODE=true

# Activar Auditoría y Radiografía Técnica Pasiva de red
RECON_MODE=true

# Rutas de destino y organización de artefactos
# Directorio base de salida (por defecto: ./output)
OUTPUT_DIR=./output

# Categoría o subcarpeta opcional para clasificar los reportes dentro del target
# Ejemplo: TARGET_CATEGORY=informes
TARGET_CATEGORY=

