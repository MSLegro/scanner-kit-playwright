{
  "name": "scanner-kit-playwright",
  "version": "1.0.0",
  "description": "Universal Web Reconnaissance and Automation Kit for Playwright & TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "scan": "ts-node src/examples/run-scan.ts",
    "verify": "ts-node src/examples/verify-suite.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "playwright",
    "rpa",
    "reconnaissance",
    "api-spy",
    "automation",
    "reverse-engineering",
    "typescript"
