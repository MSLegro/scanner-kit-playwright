  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.7",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
