{
  "name": "scanner-kit-playwright",
  "version": "1.1.0",
  "description": "Universal Web Reconnaissance and Automation Kit for Playwright & TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sk": "dist/cli.js",
    "scanner-kit": "dist/cli.js",
    "scanner-kit-playwright": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "build": "tsc",
    "postbuild": "node -e \"try { require('fs').chmodSync('dist/cli.js', 0o755); } catch (e) {}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build",
    "start": "node dist/cli.js",
    "scan": "node dist/cli.js",
    "scan:dev": "ts-node src/cli.ts",
    "verify": "ts-node src/examples/verify-suite.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "playwright",
    "rpa",
    "reconnaissance",
    "api-spy",
    "automation",
    "reverse-engineering",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.7",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
